# =============================================================================
# VARIABLES DE ENTORNO PARA FULLCOLOR COTIZADOR
# =============================================================================
# Copia este archivo como .env.local y completa con tus valores reales
# NUNCA commitees .env.local al repositorio (ya está en .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (REQUERIDO)
# -----------------------------------------------------------------------------
# Obtén estos valores desde: https://supabase.com/dashboard/project/_/settings/api
# URL de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clave pública/anon de Supabase (segura para exponerse en el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# SUPABASE SERVICE ROLE (OPCIONAL - Solo para operaciones admin/backend)
# -----------------------------------------------------------------------------
# ⚠️  ADVERTENCIA: Esta clave tiene privilegios totales. NO expongas en el cliente
# Solo usa en API routes o funciones server-side
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE NODE/NEXT.JS
# -----------------------------------------------------------------------------
# Entorno de ejecución (development, production, test)
NODE_ENV=development

# -----------------------------------------------------------------------------
# ANALYTICS (OPCIONAL)
# -----------------------------------------------------------------------------
# Si usas Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id

# -----------------------------------------------------------------------------
# VARIABLES PARA TESTING
# -----------------------------------------------------------------------------
# Estas son configuradas automáticamente en tests/setup/jest.setup.ts
# No necesitas definirlas aquí a menos que quieras sobrescribirlas
# NEXT_PUBLIC_SUPABASE_URL=https://test.supabase.co (en tests)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=test-anon-key (en tests)

# -----------------------------------------------------------------------------
# VALIDACIÓN DE VARIABLES
# -----------------------------------------------------------------------------
# Para validar que todas las variables están configuradas correctamente:
# node scripts/validate-env.js

# -----------------------------------------------------------------------------
# DESPLIEGUE EN VERCEL
# -----------------------------------------------------------------------------
# En Vercel, configura estas variables en:
# Project Settings > Environment Variables
# 
# Variables requeridas:
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# Asegúrate de configurarlas para los entornos:
# - Production
# - Preview (opcional, puedes usar un proyecto Supabase de staging)
# - Development (opcional)
