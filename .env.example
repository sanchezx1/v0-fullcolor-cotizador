# Public environment variables (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=FullColor
NEXT_PUBLIC_COMPANY_EMAIL=info@fullcolor.com
NEXT_PUBLIC_COMPANY_PHONE=+593991234567

# Server-only secrets
SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=
REVALIDATE_SECRET=generate-with-openssl-rand-hex-32

# Email configuration (Resend)
# FROM_EMAIL debe ser un email con dominio verificado en https://resend.com/domains
# Para pruebas sin dominio verificado: onboarding@resend.dev (solo envia a tu propio email)
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=ventas@fullcolor.com.ec
FROM_NAME=FullColor
ADMIN_EMAIL=carlosmatiasflor@gmail.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_NUMBER=
WHATSAPP_MESSAGE_TEMPLATE=Hola, necesito información sobre la cotización #\{QUOTE_ID}

# Tooling / QA
PLAYWRIGHT_TEST_BASE_URL=http://127.0.0.1:3000
ANALYZE=false
